{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-builder-platform.local/schemas/agent.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agents.v1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "description": { "type": "string" },
        "owners": {
          "type": "array",
          "items": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "inputs": { "type": "object" },
        "outputs": { "type": "object" },
        "nodes": {
          "type": "array",
          "items": { "type": "object" },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        "start": { "type": "string" }
      }
    }
  }
}
